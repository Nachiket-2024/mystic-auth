# ---------------------------- Python / Backend ----------------------------
# **/ prefix is required for these to match at any depth, not just directly
# under the build context root, since a bare "__pycache__/" misses nested dirs.
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
*.sqlite3
*.db
*.log
# backend/logs/: rotated access-log files (real request data: paths,
# timestamps, correlation IDs). `*.log` above only matches exactly ".log",
# not rotated siblings like access.log.2026-07-19, which were previously
# getting baked into the image via `COPY backend/ .`, a real privacy leak.
backend/logs/
**/*.egg-info/
dist/
build/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
backend/.cache/
**/.dmypy.json
.coverage
htmlcov/
.venv/
venv/

# ---------------------------- Node / Frontend ----------------------------
node_modules/
frontend/node_modules/
frontend/dist/

# ---------------------------- Secrets ----------------------------
# Defense-in-depth against a future `COPY . .` baking real secrets into an
# image. Neither Dockerfile currently copies the repo root.
.env
env/.env
env/.env.local-prod-cloudflare
env/.env.local-prod-ngrok
env/.env.local-prod-tailscale
env/.env.prod
frontend/.env
# Real credentials for local-scripts/{dev,local-prod-*,prod}/create-system-user.*;
# these never need to be inside a build context, only run against a running
# container from the host.
local-scripts/**/system-user.env
# frontend/coverage/: vitest --coverage output, regenerated by every
# `npm run test:coverage`.
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
npm-debug.log
yarn-error.log
pnpm-debug.log

# ---------------------------- Docker ----------------------------
# Do not include this file inside the image.
.dockerignore
.git
.gitignore

# ---------------------------- General ----------------------------
.DS_Store
*.swp
