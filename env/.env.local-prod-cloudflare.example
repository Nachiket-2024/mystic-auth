# Local-prod config: used by docker/compose/docker-compose.local-prod-cloudflare.yml.
# Copy: `cp env/.env.local-prod-cloudflare.example env/.env.local-prod-cloudflare`,
# or run scripts/mystic_auth/env-tools/setup-env/setup-env.sh to do this (and every other mode)
# with fresh generated secrets in one go.
# Exposes the production image/runtime shape via a free Cloudflare Tunnel.
# See docs/mystic_auth/deployment/local-prod/README.md.
# Full field docs: docs/mystic_auth/environment/{backend,frontend,compose}.md

# ---------------------------- Change these ----------------------------
# Preconfigured for Quick Tunnel, the default: nothing here needs changing
# to start the stack. For a Named Tunnel (stable custom domain) instead,
# see docs/mystic_auth/deployment/local-prod/README.md.
TUNNEL_TOKEN=

GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GOOGLE_REDIRECT_URI=http://localhost/auth/oauth2/callback/google

FROM_EMAIL=<your_google_email>
GMAIL_APP_PASSWORD=<your_gmail_app_password>
SUPPORT_EMAIL=<your_support_email>

# Rotate all of these to real, unique values before real use.
SECRET_KEY=change_me_in_production_generate_your_own_random_32plus_char_key
POSTGRES_PASSWORD=change_me_in_production
APP_DB_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@postgres:5432/mystic_auth
APP_DATABASE_URL=postgresql+asyncpg://mystic_auth_app:change_me_in_production@postgres:5432/mystic_auth
BUGSINK_SECRET_KEY=change_me_in_production_generate_your_own_random_50plus_char_key
BUGSINK_SUPERUSER_EMAIL=admin@example.com
BUGSINK_SUPERUSER_PASSWORD=change_me_in_production

BRAND_COLOR=#d97706

DEFAULT_APP_POLICIES=

# Only if another project/service already uses these ports/subnet.
# FRONTEND_STATIC_IP/CLOUDFLARED_STATIC_IP must stay inside DOCKER_SUBNET.
# See docs/mystic_auth/docker/compose-modes.md.
COMPOSE_PROJECT_NAME=mystic-auth-local-prod-cloudflare
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=8080
DOCKER_SUBNET=172.28.0.0/24
FRONTEND_STATIC_IP=172.28.0.10
CLOUDFLARED_STATIC_IP=172.28.0.11

# ---------------------------- App Config ----------------------------
BACKEND_BASE_URL=http://localhost

# Update to your Named Tunnel domain if you set one up.
FRONTEND_BASE_URL=http://localhost
JWT_ISSUER=http://localhost
JWT_AUDIENCE=http://localhost

FRONTEND_ADDITIONAL_BASE_URLS=
ACCOUNT_PURGE_GRACE_DAYS=30
USER_EXPORT_MAX_ROWS=50000

# ---------------------------- Frontend Config ----------------------------
# Leave empty: nginx proxies API calls to backend same-origin, so the app
# works through any tunnel URL with no updates. Do not set this to a URL.
VITE_API_BASE_URL=
VITE_APP_LOGO_URL=
VITE_APP_FAVICON_URL=

# Bugsink fills this after startup. See SENTRY_DSN below.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# ---------------------------- Database Config ----------------------------
POSTGRES_USER=postgres
POSTGRES_DB=mystic_auth

# ---------------------------- Scaling Config ----------------------------
# See docs/mystic_auth/deployment/environment.md#7-scaling-and-load-capacity.
UVICORN_WORKERS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------- JWT Config ----------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256
RESET_TOKEN_EXPIRE_MINUTES=60
ACCOUNT_DELETE_TOKEN_EXPIRE_MINUTES=60

# ---------------------------- Redis Config ----------------------------
# Set a strong password for your own server, then include it in REDIS_URL
# too (setting REDIS_PASSWORD alone does nothing): see
# docs/mystic_auth/security/hardening-infra.md#redis-authentication.
REDIS_PASSWORD=
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL=300

# ---------------------------- Email / SMTP Config ----------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ENABLED=true

# ---------------------------- App Name & Branding Config ----------------------------
APP_NAME=MysticAuth

# ---------------------------- Rate Limiter Config ----------------------------
LOGIN_LOCKOUT_TIME=300
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME_PER_IP=300
MAX_FAILED_LOGIN_ATTEMPTS_PER_IP=20
MAX_REQUESTS_PER_WINDOW=100
REQUEST_WINDOW_SECONDS=60

# ---------------------------- Logging Config ----------------------------
LOG_LEVEL=INFO

# ---------------------------- Environment Config ----------------------------
ENVIRONMENT=production

# ---------------------------- Reverse Proxy Config ----------------------------
# Not set here: docker-compose.local-prod-cloudflare.yml derives and
# overrides it for the backend service from FRONTEND_STATIC_IP/
# CLOUDFLARED_STATIC_IP above. Defaults to empty for every other service,
# which don't use it.

# To enable, see docs/mystic_auth/geolocation/overview.md.
GEOIP_DB_PATH=
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=

# Always-on db_backup service. See
# docs/mystic_auth/deployment/local-prod/README.md.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_UPLOAD_COMMAND=

# ---------------------------- Error Monitoring Config ----------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Published to localhost only, not tunneled.
BUGSINK_BASE_URL=http://localhost:8011
