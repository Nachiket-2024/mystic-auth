# Local-prod config: used by docker/compose/docker-compose.local-prod-ngrok.yml.
# Copy: `cp env/.env.local-prod-ngrok.example env/.env.local-prod-ngrok`.
# Exposes the production image/runtime shape via a free ngrok tunnel with a
# stable domain. See docs/mystic_auth/deployment/local-prod/ngrok-tunnel.md.

# NGROK_AUTHTOKEN/NGROK_DOMAIN near the bottom are required.

# ---------------------------- App Config ----------------------------
BACKEND_BASE_URL=http://localhost

# Update to https://<NGROK_DOMAIN> once you've set that up below.
FRONTEND_BASE_URL=http://localhost

# Optional, comma-separated extra CORS origins (e.g. staging alongside prod).
# Empty = none.
FRONTEND_ADDITIONAL_BASE_URLS=

# Optional, comma-separated names of your own app's policies, auto-assigned
# to every user alongside self_service once verified. Empty (default) =
# self_service only.
DEFAULT_APP_POLICIES=

# Days a self-deleted/admin-deleted account (deleted_at set) is kept before
# procrastinate_tasks/account_purge_tasks.py's daily job hard-purges it.
ACCOUNT_PURGE_GRACE_DAYS=30

# Hard ceiling on GET /users/export's filtered row count. See .env.example
# for details.
USER_EXPORT_MAX_ROWS=50000

# ---------------------------- Frontend Config ----------------------------
# VITE_APP_NAME/VITE_SUPPORT_EMAIL/VITE_BRAND_COLOR are not set here - the
# compose file's frontend build args reuse APP_NAME/SUPPORT_EMAIL/
# BRAND_COLOR below instead of duplicating them.
# Leave empty: nginx proxies API calls to backend same-origin, so the app
# works through any tunnel URL with no updates. Do not set this to a URL.
VITE_API_BASE_URL=
# Optional: logo image shown instead of the text wordmark (Sidebar,
# AuthLayout). Any URL - a bundled asset, an absolute path, or a remote
# image. Leave blank to keep the built-in key badge plus APP_NAME wordmark.
VITE_APP_LOGO_URL=

# Bugsink fills this after startup. See SENTRY_DSN below.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# ---------------------------- Database Config ----------------------------
# Rotate to real values before real use.
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@postgres:5432/mystic_auth

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=mystic_auth

# Least-privilege role the app/worker use for normal request traffic (CRUD
# only, no schema/DDL rights); DATABASE_URL above (superuser) still runs
# migrations. Blank APP_DATABASE_URL falls back to DATABASE_URL. See
# docs/mystic_auth/security/decisions-infra.md.
APP_DB_PASSWORD=change_me_in_production
APP_DATABASE_URL=postgresql+asyncpg://mystic_auth_app:change_me_in_production@postgres:5432/mystic_auth

# ---------------------------- Scaling Config ----------------------------
# uvicorn workers for the backend service (dev uses --reload, incompatible
# with --workers). UVICORN_WORKERS * (DB_POOL_SIZE + DB_MAX_OVERFLOW) must
# stay under Postgres's own max_connections. See
# docs/mystic_auth/deployment/environment.md.
UVICORN_WORKERS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------- JWT Config ----------------------------
# Generate your own (`openssl rand -base64 32`) before real use. Must be at
# least 32 characters.
SECRET_KEY=change_me_in_production_generate_your_own_random_32plus_char_key

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256

# "iss"/"aud" claims minted into every JWT. Set both to your real ngrok
# domain in the ngrok Tunnel Config section below (same value as
# FRONTEND_BASE_URL) once you know it - see the ngrok tunnel doc's
# "Point the app at that domain" step.
JWT_ISSUER=http://localhost
JWT_AUDIENCE=http://localhost
RESET_TOKEN_EXPIRE_MINUTES=60

# Lifetime of the confirmation link sent for OAuth-only accounts'
# self-service account deletion, in minutes.
ACCOUNT_DELETE_TOKEN_EXPIRE_MINUTES=60

# ---------------------------- OAuth2 / Gmail Config ----------------------------
# The CLI-created system superuser does not need Google or SMTP.
# Regular users need SMTP verification for password signup, or Google login.
# See the ngrok Tunnel Config section below for GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GOOGLE_REDIRECT_URI=http://localhost/auth/oauth2/callback/google

# ---------------------------- Redis Config ----------------------------
REDIS_PASSWORD=

# If REDIS_PASSWORD is set, include it too:
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=redis://redis:6379/0

CACHE_DEFAULT_TTL=300

# ---------------------------- Email / SMTP Config ----------------------------
# Also used below by the bugsink service for its own new-issue alert emails
# (Django reads different EMAIL_* names; see docs/mystic_auth/error-monitoring/overview.md).
FROM_EMAIL=<your_google_email>
GMAIL_APP_PASSWORD=<your_gmail_app_password>
# Reply-To address shown in email footers, and the contact address shown
# on the frontend's Terms of Service / Privacy Policy pages.
SUPPORT_EMAIL=<your_support_email>

# Override to point emails/email_sender.py at another provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Set to false to route every email through NullEmailSender (logs
# recipient/subject only, opens no SMTP connection) instead of really
# sending - useful for local dev/test runs against a real provider (a
# personal Gmail account has a real daily send quota) so exercising
# signup/password-reset/account-deletion flows doesn't burn it. Test runs
# (tests/backend/conftest.py) force this false regardless of this value.
EMAIL_ENABLED=true

# ---------------------------- App Name & Branding Config ----------------------------
APP_NAME=MysticAuth

# Default brand color (hex). Generates the whole brand scale - see
# docs/mystic_auth/appearance/overview.md#default-brand-color.
BRAND_COLOR=#d97706

# ---------------------------- Rate Limiter Config ----------------------------
LOGIN_LOCKOUT_TIME=300
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME_PER_IP=300
MAX_FAILED_LOGIN_ATTEMPTS_PER_IP=20
MAX_REQUESTS_PER_WINDOW=100
REQUEST_WINDOW_SECONDS=60

# ---------------------------- Logging Config ----------------------------
LOG_LEVEL=INFO

# ---------------------------- Environment Config ----------------------------
ENVIRONMENT=production

# ---------------------------- Reverse Proxy Config ----------------------------
TRUSTED_PROXY_IPS=172.30.0.10,172.30.0.11

# Path to a local MaxMind GeoLite2-City .mmdb file (see env/.env.example
# for details). To enable via Docker, set GEOIPUPDATE_ACCOUNT_ID/LICENSE_KEY
# below, set this to /usr/share/GeoIP/GeoLite2-City.mmdb, then start with
# `--profile geoip` added to the compose command in this file's header.
GEOIP_DB_PATH=

# Free MaxMind account + license key (https://www.maxmind.com/en/geolite2/signup)
# for the geoipupdate service above. Leave both blank if not using geoipupdate.
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=

# Scheduled Postgres dump interval/retention for the always-on db_backup
# service. Both have working defaults (24h / 14 days) if left blank.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Optional: shell command run after each verified dump, with DUMP_FILE
# exported to it, to ship the dump off-host (backups otherwise sit on the
# same disk as the database they protect - see docs/mystic_auth/concerns).
# Blank by default. Example: aws s3 cp "$DUMP_FILE" s3://my-bucket/
BACKUP_UPLOAD_COMMAND=

# ---------------------------- ngrok Tunnel Config ----------------------------
# Both required. See docs/mystic_auth/deployment/local-prod/ngrok-tunnel.md.
#
# NGROK_AUTHTOKEN: ngrok dashboard > Getting Started > Your Authtoken.
# NGROK_DOMAIN: your account's free static domain (dashboard > Domains),
# without the "https://" prefix, e.g. "my-app.ngrok-free.app".
NGROK_AUTHTOKEN=<your_ngrok_authtoken>
NGROK_DOMAIN=<your-app>.ngrok-free.app

# ---------------------------- Error Monitoring Config ----------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Bugsink's own secret key (unrelated to this app's SECRET_KEY above).
# Generate your own (`openssl rand -base64 50`) before real use.
BUGSINK_SECRET_KEY=change_me_in_production_generate_your_own_random_50plus_char_key

BUGSINK_SUPERUSER_EMAIL=admin@example.com
BUGSINK_SUPERUSER_PASSWORD=change_me_in_production

# Published to localhost only, not tunneled.
BUGSINK_BASE_URL=http://localhost:8111
