# ---------------------------- Python ----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.venv/
venv/
.Python
*.sqlite3
*.db

# ---------------------------- Secrets and env files ----------------------------
# Real env files and credentials stay local. Only the .example templates are
# tracked. .dockerignore repeats these so they never enter a build context.
.env
.envrc
env/mystic_auth/.env.*
!env/mystic_auth/.env.*.example
env/mystic_auth/.cloudflare-tunnel-token
!env/mystic_auth/.cloudflare-tunnel-token.example
env/app/.env.*
!env/app/.env.*.example
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.*.example
SECRETS-TO-ROTATE.md
# Private keys and exported key containers must stay local.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519

