# Dev config: used by docker-compose.yml. Copy to .env: `cp .env.example .env`.

# ---------------------------- App Config ----------------------------
# URL where the backend is reachable
BACKEND_BASE_URL=http://localhost:8000

# URL where the frontend is reachable. Used for OAuth, verification, and
# password-reset links. Put extra CORS origins below.
FRONTEND_BASE_URL=http://localhost:5173

# Optional, comma-separated extra CORS origins (e.g. staging alongside prod).
# Empty = none.
FRONTEND_ADDITIONAL_BASE_URLS=

# Optional, comma-separated names of your own app's policies, auto-assigned
# to every user alongside self_service once verified. Empty (default) =
# self_service only.
DEFAULT_APP_POLICIES=

# Days a self-deleted/admin-deleted account (deleted_at set) is kept before
# procrastinate_tasks/account_purge_tasks.py's daily job hard-purges it.
ACCOUNT_PURGE_GRACE_DAYS=30

# Hard ceiling on GET /users/export's filtered row count (that endpoint has
# no offset/limit; requests over this are rejected instead of loading
# everything into memory).
USER_EXPORT_MAX_ROWS=50000

# ---------------------------- Frontend Config ----------------------------
# VITE_APP_NAME/VITE_SUPPORT_EMAIL are not set here - docker-compose.yml's
# frontend service reuses APP_NAME/SUPPORT_EMAIL below instead of duplicating
# them.
VITE_API_BASE_URL=http://localhost:8000
# Optional: logo image shown instead of the default key badge (Sidebar,
# AuthLayout). Any URL - a bundled asset, an absolute path, or a remote
# image. Leave blank to keep the built-in key badge + APP_NAME wordmark.
VITE_APP_LOGO_URL=

# Bugsink fills this after startup. See SENTRY_DSN below.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# ---------------------------- Database Config ----------------------------
# Change the password (keeping DATABASE_URL in sync) before real use.
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@postgres:5432/mystic_auth

# Used when running the backend locally instead of in Docker
# DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@localhost:5433/mystic_auth

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=mystic_auth

# Least-privilege role the app/worker use for normal request traffic (CRUD
# only, no schema/DDL rights); DATABASE_URL above (superuser) still runs
# migrations. Blank APP_DATABASE_URL falls back to DATABASE_URL. See
# docs/mystic_auth/security/decisions-infra.md.
APP_DB_PASSWORD=change_me_in_production
APP_DATABASE_URL=postgresql+asyncpg://mystic_auth_app:change_me_in_production@postgres:5432/mystic_auth

# ---------------------------- JWT Config ----------------------------
# Generate your own (`openssl rand -base64 32`) before real use. Must be at
# least 32 characters.
SECRET_KEY=change_me_in_production_generate_your_own_random_32plus_char_key

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256

# "iss"/"aud" claims minted into every JWT. Typically both BACKEND_BASE_URL,
# since this API issues and validates its own tokens.
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=http://localhost:8000

RESET_TOKEN_EXPIRE_MINUTES=60

# Lifetime of the confirmation link sent for OAuth-only accounts'
# self-service account deletion, in minutes.
ACCOUNT_DELETE_TOKEN_EXPIRE_MINUTES=60

# ---------------------------- OAuth2 / Gmail Config ----------------------------
# The CLI-created system superuser does not need Google or SMTP.
# Regular users need SMTP verification for password signup, or Google login.
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth2/callback/google

# ---------------------------- Redis Config ----------------------------
REDIS_PASSWORD=

# If REDIS_PASSWORD is set, include it too:
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=redis://redis:6379/0

# Used when running the backend locally (Redis still runs in Docker)
# REDIS_URL=redis://localhost:6380/0

CACHE_DEFAULT_TTL=300

# ---------------------------- Email / SMTP Config ----------------------------
# Address emails are sent from (also the SMTP login username)
FROM_EMAIL=<your_google_email>

# Gmail App Password for the account above
GMAIL_APP_PASSWORD=<your_gmail_app_password>

# Reply-To address shown in email footers, and the contact address shown
# on the frontend's Terms of Service / Privacy Policy pages. Defaults to
# FROM_EMAIL.
SUPPORT_EMAIL=<your_support_email>

# Override to point emails/email_sender.py at another provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Set to false to route every email through NullEmailSender (logs
# recipient/subject only, opens no SMTP connection) instead of really
# sending - useful for local dev/test runs against a real provider (a
# personal Gmail account has a real daily send quota) so exercising
# signup/password-reset/account-deletion flows doesn't burn it. Test runs
# (tests/backend/conftest.py) force this false regardless of this value.
EMAIL_ENABLED=true

# ---------------------------- App Name Config ----------------------------
APP_NAME=MysticAuth

# ---------------------------- Rate Limiter Config ----------------------------
LOGIN_LOCKOUT_TIME=300
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME_PER_IP=300
MAX_FAILED_LOGIN_ATTEMPTS_PER_IP=20
MAX_REQUESTS_PER_WINDOW=100
REQUEST_WINDOW_SECONDS=60

# ---------------------------- Logging Config ----------------------------
LOG_LEVEL=INFO

# ---------------------------- Environment Config ----------------------------
# Production hides /docs, /redoc, and /openapi.json.
ENVIRONMENT=development

# ---------------------------- Reverse Proxy Config ----------------------------
# Comma-separated IPs of trusted reverse proxies. Empty = never trust
# X-Forwarded-For, use request.client.host as-is (correct for local dev,
# no proxy in front of the dev server).
TRUSTED_PROXY_IPS=

# Path to a local MaxMind GeoLite2-City .mmdb file, used to resolve login
# IPs for Manage Sessions' Location column. Empty = disabled. See
# docs/mystic_auth/geolocation/overview.md.
GEOIP_DB_PATH=

# ---------------------------- Error Monitoring Config ----------------------------
# Auto-filled once Bugsink starts. See docs/mystic_auth/error-monitoring/overview.md.
SENTRY_DSN=

# Optional tag shown on every reported error (e.g. "production").
SENTRY_ENVIRONMENT=

# Bugsink's own secret key (unrelated to this app's SECRET_KEY above).
# Generate your own (`openssl rand -base64 50`) before real use.
BUGSINK_SECRET_KEY=change_me_in_production_generate_your_own_random_50plus_char_key

# Admin login for Bugsink's own UI
BUGSINK_SUPERUSER_EMAIL=admin@example.com
BUGSINK_SUPERUSER_PASSWORD=change_me_in_production

# URL where you'll open Bugsink's UI
BUGSINK_BASE_URL=http://localhost:8010
