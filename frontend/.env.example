# Only needed when running the frontend locally with `npm run dev`.
# Docker uses the root .env VITE_* values and ignores this file.

# Backend base URL
VITE_API_BASE_URL=http://localhost:8000

# Product name shown in the UI (navbar, auth pages, document title)
VITE_APP_NAME=MysticAuth

# Optional: logo image shown instead of the text wordmark. Leave blank to
# keep the plain-text VITE_APP_NAME wordmark.
VITE_APP_LOGO_URL=

# Optional: contact address shown on the Terms of Service / Privacy Policy
# pages. Leave blank to show a "replace this" placeholder instead.
VITE_SUPPORT_EMAIL=

# ---------------------------- Error Monitoring ----------------------------
# Leave blank to disable. See docs/mystic_auth/error-monitoring/overview.md.
VITE_SENTRY_DSN=

# Optional tag shown on every reported error (e.g. "production").
# Falls back to Vite's MODE if unset.
VITE_SENTRY_ENVIRONMENT=
